<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that is not a window: the tablet's facts, the desktop's pen settings, reading the pen. -->
  <PropertyGroup>
    <RootNamespace>Xperience.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xperience.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tablets the driver takes: the same list the driver and its probe are built from. -->
    <EmbeddedResource Include="../../driver/models.tsv" LogicalName="models.tsv" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" Version="$(TmdsDBusVersion)" />
  </ItemGroup>
</Project>
