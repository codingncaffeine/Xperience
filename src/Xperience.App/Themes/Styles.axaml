<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource XpText}" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource XpCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- The sidebar's page buttons. -->
    <Style Selector="Button.nav">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource XpCard}" />
        <Setter Property="Foreground" Value="{DynamicResource XpText}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource XpAccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource XpAccent}" />
    </Style>
    <Style Selector="Button.nav PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- A plain button on a card or the page. -->
    <Style Selector="Button.action">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource XpCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource XpText}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource XpCardHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XpAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource XpText}" />
    </Style>
    <Style Selector="Button.action.primary">
        <Setter Property="Background" Value="{DynamicResource XpAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XpAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource XpOnAccent}" />
    </Style>
    <Style Selector="Button.action.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource XpAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource XpOnAccent}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.action.picked">
        <Setter Property="BorderBrush" Value="{DynamicResource XpAccent}" />
        <Setter Property="Background" Value="{DynamicResource XpAccentSoft}" />
    </Style>

    <!-- A small square button that holds one icon. -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource XpCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource XpCardHover}" />
        <Setter Property="Foreground" Value="{DynamicResource XpText}" />
    </Style>
    <Style Selector="Button.icon.picked">
        <Setter Property="BorderBrush" Value="{DynamicResource XpAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource XpAccent}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</Styles>
