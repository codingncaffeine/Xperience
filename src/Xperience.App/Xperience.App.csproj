<Project Sdk="Microsoft.NET.Sdk">
  <!-- xperience: the settings window. It keeps no pen state of its own: what it shows is read from the
       desktop, and every change is written there and read back. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>xperience</AssemblyName>
    <RootNamespace>Xperience.App</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xperience.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Beside the program too, for the desktop entries that point at it. -->
    <None Include="Assets\icon.png" Link="xperience.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xperience.Core\Xperience.Core.csproj" />
  </ItemGroup>
</Project>
