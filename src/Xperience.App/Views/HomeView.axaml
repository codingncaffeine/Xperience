<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Xperience.App.ViewModels"
             xmlns:c="using:Xperience.App.Controls"
             x:Class="Xperience.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Profiles on the left; calibration and defaults on the right -->
        <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileTab">
                                <Button Classes="profile" Classes.picked="{Binding Selected}"
                                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).SelectProfileCommand}"
                                        CommandParameter="{Binding App}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource XpGood}" VerticalAlignment="Center"
                                                 IsVisible="{Binding Active}" ToolTip.Tip="In use right now" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="icon" Width="34" Height="34" CornerRadius="999" Command="{Binding AddProfileCommand}"
                            ToolTip.Tip="Add a profile for one application">
                        <PathIcon Data="{StaticResource IconPlus}" Width="13" Height="13" />
                    </Button>
                    <Button Classes="icon" Width="34" Height="34" CornerRadius="999" Command="{Binding RemoveProfileCommand}"
                            IsVisible="{Binding CanRemoveProfile}" ToolTip.Tip="Remove this profile">
                        <PathIcon Data="{StaticResource IconMinus}" Width="13" Height="13" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <Button Classes="icon" Command="{Binding Main.WorkArea.CalibrateCommand}" ToolTip.Tip="Calibrate the pen against the screen">
                    <PathIcon Data="{StaticResource IconCalibrate}" Width="17" Height="17" />
                </Button>
                <Button Classes="icon" Command="{Binding ResetKeysCommand}" ToolTip.Tip="Put this profile's keys and dials back to their defaults">
                    <PathIcon Data="{StaticResource IconUndo}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>

        <c:TabletArt Grid.Row="1" Model="{Binding Model}" Turned="{Binding Turned}" KeyLabels="{Binding KeyLabels}"
                     DialLabels="{Binding DialLabels}" KeyCommand="{Binding EditKeyCommand}" DialCommand="{Binding EditDialCommand}"
                     Dimmed="{Binding KeysDisabled}" Margin="24,14,24,16" MaxWidth="860" />

        <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,0,0,16" MaxWidth="860" IsVisible="{Binding ShowMode}">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding ModeTitle}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding ModeText}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
            <Button Classes="action" MinWidth="200" Content="Floating menu" Command="{Binding Main.ShowFloatingMenuCommand}" />
            <Button Classes="action" MinWidth="200" Content="Work area" Command="{Binding Main.ShowWorkAreaCommand}" />
            <Button Classes="action" MinWidth="200" Content="Pen settings" Command="{Binding Main.ShowPenCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
