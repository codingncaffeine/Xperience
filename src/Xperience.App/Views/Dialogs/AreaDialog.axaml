<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Xperience.App.ViewModels"
        xmlns:c="using:Xperience.App.Controls"
        x:Class="Xperience.App.Views.Dialogs.AreaDialog"
        x:DataType="vm:AreaDialogViewModel"
        Title="{Binding Title}"
        Width="820" Height="640" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource XpBg}">
    <Window.Styles>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24,20,24,20">
        <StackPanel Spacing="6" Margin="0,0,0,12">
            <TextBlock Classes="title" Text="{Binding Title}" FontSize="17" />
            <TextBlock Classes="muted" Text="{Binding Hint}" />
        </StackPanel>
        <Border Grid.Row="1" Classes="card" Padding="10">
            <c:AreaPicker Area="{Binding Area}" SurfaceAspect="{Binding SurfaceAspect}" Parts="{Binding Parts}" DarkSurface="{Binding DarkSurface}" />
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,18,Auto,*,18,Auto,*,18,Auto,*,12,Auto" Margin="0,16,0,0">
            <TextBlock Classes="field" Text="X" />
            <NumericUpDown Grid.Column="1" Value="{Binding X}" Maximum="{Binding MaxWidth}" FormatString="{Binding Format}" Increment="{Binding Step}" />
            <TextBlock Grid.Column="3" Classes="field" Text="Y" />
            <NumericUpDown Grid.Column="4" Value="{Binding Y}" Maximum="{Binding MaxHeight}" FormatString="{Binding Format}" Increment="{Binding Step}" />
            <TextBlock Grid.Column="6" Classes="field" Text="Width" />
            <NumericUpDown Grid.Column="7" Value="{Binding Width}" Maximum="{Binding MaxWidth}" FormatString="{Binding Format}" Increment="{Binding Step}" />
            <TextBlock Grid.Column="9" Classes="field" Text="Height" />
            <NumericUpDown Grid.Column="10" Value="{Binding Height}" Maximum="{Binding MaxHeight}" FormatString="{Binding Format}" Increment="{Binding Step}" />
            <TextBlock Grid.Column="12" Classes="field" Text="{Binding Unit}" Margin="0" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,10,Auto" Margin="0,18,0,0">
            <Button Classes="action" Content="Whole area" Command="{Binding UseWholeCommand}" />
            <Button Grid.Column="2" Classes="action" Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="96" />
            <Button Grid.Column="4" Classes="action primary" Content="OK" Click="OnOk" MinWidth="96" />
        </Grid>
    </Grid>
</Window>
