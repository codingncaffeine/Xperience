<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Xperience.App.ViewModels"
             x:Class="Xperience.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.key">
            <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
        <Style Selector="TextBlock.about">
            <Setter Property="Foreground" Value="{DynamicResource XpTextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="28,-4,0,6" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Spacing="14" Width="780" HorizontalAlignment="Left" Margin="0,0,16,0">
            <Border CornerRadius="10" Padding="14,10" Background="{DynamicResource XpAccentSoft}"
                    IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Classes="heading" Text="COMMON" />
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="action" Content="Export settings…" Command="{Binding ExportCommand}" MinWidth="170" />
                        <Button Classes="action" Content="Import settings…" Command="{Binding ImportCommand}" MinWidth="170" />
                        <Button Classes="action" Content="Default settings…" Command="{Binding RestoreDefaultsCommand}" MinWidth="170" />
                    </StackPanel>
                    <StackPanel>
                        <CheckBox Content="Show what a key does when it is pressed" IsChecked="{Binding Hints}" />
                        <CheckBox Content="Switch off every key and dial on the tablet" IsChecked="{Binding KeysDisabled}" />
                        <CheckBox Content="Keep Xperience running when its window is closed" IsChecked="{Binding KeepRunning}" />
                        <TextBlock Classes="about"
                                   Text="Plain shortcuts and clicks are carried out by the desktop and work either way. Hints, switching a dial's function, application profiles, the floating menu and the other special actions are Xperience's own and need it running." />
                        <CheckBox Content="Start Xperience with the desktop" IsChecked="{Binding StartWithDesktop}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="heading" Text="DRIVER" Margin="0,6,0,0" />
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding DriverTitle}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding DriverText}" />
                    <SelectableTextBlock Text="{Binding DriverCommand}" FontFamily="monospace" Foreground="{DynamicResource XpText}"
                                         IsVisible="{Binding DriverCommand, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="action" Content="{Binding InstallLabel}" Command="{Binding InstallDriverCommand}" MinWidth="170"
                                IsEnabled="{Binding CanInstallDriver}" />
                        <Button Classes="action" Content="Remove driver…" Command="{Binding RemoveDriverCommand}" MinWidth="170"
                                IsVisible="{Binding CanRemoveDriver}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="heading" Text="DIAGNOSTICS" Margin="0,6,0,0" />
            <Border Classes="card">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="key" Text="Tablet" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding TabletLine}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Classes="key" Text="Mode" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ModeLine}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Classes="key" Text="Desktop" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding DesktopLine}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Classes="key" Text="Pen device" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding PenLine}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Classes="key" Text="Pen mapped to" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding MappingLine}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock Classes="heading" Text="PEN RIGHT NOW" Margin="0,6,0,0" />
            <Border Classes="card">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="key" Text="Tool" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Tool}" />
                    <TextBlock Grid.Row="1" Classes="key" Text="Position" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Position}" />
                    <TextBlock Grid.Row="2" Classes="key" Text="Pressure" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Pressure}" />
                    <TextBlock Grid.Row="3" Classes="key" Text="Tilt" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Tilt}" />
                </Grid>
            </Border>

            <TextBlock Classes="heading" Text="ABOUT" Margin="0,6,0,0" />
            <Border Classes="card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="key" Text="Version" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Version}" />
                    <TextBlock Grid.Row="1" Classes="key" Text="Built" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Built}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
