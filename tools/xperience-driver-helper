#!/bin/sh
# Installs or removes the Xperience tablet driver. It changes system files, so it runs as root; the settings
# window starts it through the system's own prompt for administrator rights.
#
#   xperience-driver-helper install /path/to/0010-XPPen__Artist16_3rd.bpf.o UPPER TILT LOWER KEYS SMOOTHING
#       UPPER and LOWER: what that pen button is, one of button, eraser, toggle.  TILT: on or off.
#       KEYS: the tablet keys that switch between pen and eraser, as digits 1 to 8, or none.
#       SMOOTHING: how many of the pen's positions are averaged, 1 (none) to 8.
#   xperience-driver-helper remove
#
# install: brings udev-hid-bpf from the distribution when it is missing, hands the driver to it, gives the
#          kernel back any interface of the tablet another program took, checks the pen came back, writes the udev rules that carry the pen's options and let the
#          person at the seat read the tablet's input nodes and create the virtual keyboard, then loads the
#          driver for a tablet that is plugged in.
# remove:  unloads the driver, puts the tablet back into the mode it comes in, and takes those files away again.
set -eu

name="0010-XPPen__Artist16_3rd.bpf.o"
# Tests point this at a folder of their own; outside tests it is empty and the paths are the system's.
root="${XPERIENCE_ROOT:-}"
rules="$root/etc/udev/rules.d/70-xperience.rules"

fail() {
	echo "$1" >&2
	exit "${2:-1}"
}

devices() {
	for device in "$root"/sys/bus/hid/devices/0003:28BD:097E.*; do
		[ -e "$device" ] && echo "$device"
	done
	return 0
}

# The driver switches the tablet to its raw mode, and the tablet stays there until it is told otherwise or
# unplugged. Without the driver nothing reads raw reports, so the tablet is put back into the mode it comes in:
# the three bytes 02 b0 02, padded to ten, on its vendor interface (the third of its three).
leave_raw_mode() {
	for device in $(devices); do
		grep -q '^HID_PHYS=.*/input2$' "$device/uevent" 2> /dev/null || continue
		for raw in "$device"/hidraw/hidraw*; do
			[ -e "$raw" ] || continue
			node="$root/dev/$(basename "$raw")"
			[ -e "$node" ] || continue
			printf '\002\260\002\000\000\000\000\000\000\000' > "$node" 2> /dev/null || true
		done
	done
}

# A program that drives the tablet itself, as its maker's does, takes the tablet's vendor interface away from
# the kernel and does not give it back, not even when it has ended. Without that interface the driver has no
# pen and no keys to hand on. Every interface of the tablet that no kernel driver holds is given back to the
# kernel's own HID driver, which is what unplugging the tablet and plugging it back in would do.
give_back_interfaces() {
	for usb in "$root"/sys/bus/usb/devices/*; do
		[ "$(cat "$usb/idVendor" 2> /dev/null)" = 28bd ] || continue
		[ "$(cat "$usb/idProduct" 2> /dev/null)" = 097e ] || continue
		for interface in "$usb"/*:*; do
			[ "$(cat "$interface/bInterfaceClass" 2> /dev/null)" = 03 ] || continue
			[ -e "$interface/driver" ] && continue
			basename "$interface" > "$root/sys/bus/usb/drivers/usbhid/bind" 2> /dev/null || true
		done
	done
	udevadm settle --timeout=5 || true
}

# True once the tablet is there as something to draw with: an input device under one of its HID devices. With
# the driver loaded the tablet's own two input interfaces are switched off, so any input device left is the
# driver's. Waits a few seconds for it, since the kernel makes the devices anew.
pen_is_back() {
	left=${XPERIENCE_SETTLE_SECONDS:-6}
	while :; do
		for input in "$root"/sys/bus/hid/devices/0003:28BD:097E.*/input/input*; do
			[ -e "$input" ] && return 0
		done
		[ "$left" -gt 0 ] || return 1
		left=$((left - 1))
		sleep 1
	done
}

# Unloads the driver, puts the tablet back into the mode it comes in and takes the driver's files away.
take_out() {
	# Without the loader nothing of ours can be loaded, and there is nothing to unload.
	if command -v udev-hid-bpf > /dev/null 2>&1; then
		for device in $(devices); do
			udev-hid-bpf remove "$device" > /dev/null 2>&1 || true
		done
	fi
	# The tablet's nodes are made anew when the driver lets go of it.
	udevadm settle --timeout=5 || true
	leave_raw_mode
	rm -f "$rules" "$root/etc/udev-hid-bpf/$name"
	# The rule udev-hid-bpf wrote for the driver names it; any rule file that does goes with it.
	rm -f "$root"/etc/udev/rules.d/99-hid-bpf-0010-XPPen__Artist16_3rd*.rules
	for rule in "$root"/etc/udev/rules.d/*hid-bpf*.rules; do
		[ -e "$rule" ] || continue
		if grep -q "$name" "$rule"; then rm -f "$rule"; fi
	done
	reload_rules
}

reload_rules() {
	udevadm control --reload
	# Access for the person at the seat is granted when the nodes are looked at again.
	udevadm trigger --action=change --subsystem-match=input --subsystem-match=misc || true
	udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=28bd || true
}

# The driver is loaded by udev-hid-bpf, which comes from the distribution and is not on every system. When it
# is missing, installing the driver brings it along through the system's own package manager, so nobody has to
# type a command for it.
install_loader() {
	log=$(mktemp)
	if command -v pacman > /dev/null 2>&1; then
		pacman -S --needed --noconfirm udev-hid-bpf > "$log" 2>&1
	elif command -v apt-get > /dev/null 2>&1; then
		DEBIAN_FRONTEND=noninteractive apt-get install -y udev-hid-bpf > "$log" 2>&1
	elif command -v dnf > /dev/null 2>&1; then
		dnf install -y udev-hid-bpf > "$log" 2>&1
	elif command -v zypper > /dev/null 2>&1; then
		zypper --non-interactive install udev-hid-bpf > "$log" 2>&1
	elif command -v apk > /dev/null 2>&1; then
		apk add udev-hid-bpf > "$log" 2>&1
	else
		rm -f "$log"
		fail "The package udev-hid-bpf, which loads the driver, is not installed, and this system's package manager is not one Xperience knows. Install udev-hid-bpf, then try again." 3
	fi || {
		tail -n 3 "$log" >&2
		rm -f "$log"
		fail "The package udev-hid-bpf, which loads the driver, could not be installed. If the system has updates waiting, install them and try again." 3
	}
	rm -f "$log"
	command -v udev-hid-bpf > /dev/null 2>&1 || fail "The package udev-hid-bpf was installed, but its program is not there." 3
}

command -v udevadm > /dev/null 2>&1 || fail "udevadm is not installed." 3

case "${1:-}" in
install)
	[ "$#" -eq 7 ] || fail "usage: $0 install OBJECT button|eraser|toggle on|off button|eraser|toggle KEYS|none 1-8" 2
	object="$2"
	upper="$3"
	tilt="$4"
	lower="$5"
	keys="$6"
	smoothing="$7"
	[ -f "$object" ] || fail "$object is not a file." 2
	[ "$(basename "$object")" = "$name" ] || fail "$object is not the Xperience driver." 2
	case "$upper" in button|eraser|toggle) ;; *) fail "The upper button is button, eraser or toggle, not $upper." 2 ;; esac
	case "$lower" in button|eraser|toggle) ;; *) fail "The lower button is button, eraser or toggle, not $lower." 2 ;; esac
	case "$tilt" in on|off) ;; *) fail "Tilt is on or off, not $tilt." 2 ;; esac
	case "$smoothing" in [1-8]) ;; *) fail "Smoothing is 1 to 8, not $smoothing." 2 ;; esac
	case "$keys" in
	none) keys="" ;;
	*[!1-8]* | "" | ?????????*) fail "The switch keys are digits 1 to 8, or none, not $keys." 2 ;;
	esac

	command -v udev-hid-bpf > /dev/null 2>&1 || install_loader

	# What the loader says goes to a file, so that a refusal can be told in a sentence with its last lines.
	log=$(mktemp)
	if ! udev-hid-bpf install --force "$object" > "$log" 2>&1; then
		tail -n 6 "$log" >&2
		rm -f "$log"
		fail "The system's loader for such drivers would not take this one, so nothing was changed. What it said is above." 4
	fi

	mkdir -p "$(dirname "$rules")"
	# Numbered 70: access rules only count before 73, and the pen's options have to be set before the
	# driver is loaded by the rules numbered in the 80s.
	cat > "$rules.new" <<RULES
# Written by Xperience. Change these through its settings window, which rewrites this file.

# The person at the seat may read the tablet's keys, dials and pen, and create the virtual keyboard
# Xperience types shortcuts with.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="28bd", ATTRS{idProduct}=="097e", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"

# The person at the seat may ask the tablet for its firmware version, which it keeps among its USB descriptors.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="28bd", ATTR{idProduct}=="097e", TAG+="uaccess"

# What the driver is loaded with.
SUBSYSTEM=="hid", ATTRS{idVendor}=="28bd", ATTRS{idProduct}=="097e", ENV{XPERIENCE_PEN_UPPER_BUTTON}="$upper", ENV{XPERIENCE_PEN_LOWER_BUTTON}="$lower", ENV{XPERIENCE_PEN_TILT}="$tilt", ENV{XPERIENCE_PEN_SWITCH_KEYS}="$keys", ENV{XPERIENCE_PEN_SMOOTHING}="$smoothing"
RULES
	mv "$rules.new" "$rules"
	reload_rules
	give_back_interfaces

	loaded=0
	for device in $(devices); do
		loaded=1
		if ! udev-hid-bpf add --replace \
			--property "XPERIENCE_PEN_UPPER_BUTTON=$upper" --property "XPERIENCE_PEN_LOWER_BUTTON=$lower" \
			--property "XPERIENCE_PEN_TILT=$tilt" --property "XPERIENCE_PEN_SWITCH_KEYS=$keys" --property "XPERIENCE_PEN_SMOOTHING=$smoothing" \
			"$device" "$object" > "$log" 2>&1; then
			# The kernel checks every such program before running it and says why it turns one down. A
			# driver that will not load is taken out again, so the tablet is left as it was.
			tail -n 40 "$log" >&2
			rm -f "$log"
			take_out
			fail "The kernel would not load the driver, so it was taken out again and the tablet is as it was. What the kernel said is above." 5
		fi
	done
	rm -f "$log"

	# Loaded is not yet working: the tablet has to be there as a pen again. When it is not, the driver is
	# taken out, so nobody is left with a tablet that does nothing. With no tablet plugged in there is nothing
	# to check; the rules load the driver when one is.
	if [ "$loaded" = 1 ] && ! pen_is_back; then
		take_out
		fail "The driver loaded, but the tablet did not come back as a pen, so the driver was taken out again. Unplug the tablet and plug it back in; it then works as it did before." 6
	fi
	;;
remove)
	[ "$#" -eq 1 ] || fail "usage: $0 remove" 2
	take_out
	;;
*)
	fail "usage: $0 install OBJECT button|eraser|toggle on|off button|eraser|toggle KEYS|none 1-8 | remove" 2
	;;
esac
