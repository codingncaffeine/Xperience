# name | raw report from the tablet (hex) | what the driver must hand on
#
# Raw layout: 02 kind xl xm yl ym pl ph tx ty xh yh 00 pb   (see the driver's header comment)
# Expectations: "pad" and "pen" are decoded with the descriptor the driver installs;
# "same" means the report passes through untouched.

# Keys and dials. The four dial reports are recordings from an Artist 16 3rd
# (OpenTabletDriver issue 4894); the rest are built from the layout.
dial1-up-recorded      | 02f0000000000001000000000000 | pad keys= wheel=1 pan=0
dial1-down-recorded    | 02f0000000000002000000000000 | pad keys= wheel=-1 pan=0
dial2-up-recorded      | 02f0000000000004000000000000 | pad keys= wheel=0 pan=1
dial2-down-recorded    | 02f0000000000008000000000000 | pad keys= wheel=0 pan=-1
keys-released          | 02f0000000000000000000000000 | pad keys= wheel=0 pan=0
key1                   | 02f0010000000000000000000000 | pad keys=1 wheel=0 pan=0
key8                   | 02f0800000000000000000000000 | pad keys=8 wheel=0 pan=0
key1-and-key3          | 02f0050000000000000000000000 | pad keys=1,3 wheel=0 pan=0
all-keys               | 02f0ff0000000000000000000000 | pad keys=1,2,3,4,5,6,7,8 wheel=0 pan=0
key2-while-dial1-up    | 02f0020000000001000000000000 | pad keys=2 wheel=1 pan=0
both-dials-up          | 02f0000000000005000000000000 | pad keys= wheel=1 pan=1
both-dials-down        | 02f000000000000a000000000000 | pad keys= wheel=-1 pan=-1
dial1-up-dial2-down    | 02f0000000000009000000000000 | pad keys= wheel=1 pan=-1
noise-in-placeholders  | 02f00100ffffff00000000000000 | pad keys=1 wheel=0 pan=0

# Pen. With the property unset the upper button is an eraser, as the tablet has it out of the box.
pen-hover-origin       | 02a0000000000000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=0 y=0 p=0 tx=0 ty=0
pen-far-corner-full    | 02a1670ad795ff1fc43c01000001 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=68199 y=38359 p=16383 tx=-60 ty=60
pen-x-65535            | 02a1ffff0000ff1f000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=65535 y=0 p=8191 tx=0 ty=0
pen-x-65536            | 02a1000001000000000001000001 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=65536 y=1 p=8192 tx=0 ty=0
pen-y-high-byte        | 02a00000d7950000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=0 y=38359 p=0 tx=0 ty=0
pen-pressure-masked    | 02a10000000034f2000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=0 y=0 p=4660 tx=0 ty=0
pen-lower-button       | 02a2102700100000000000000000 | pen in=1 tip=0 b1=1 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
pen-upper-button       | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
pen-both-buttons-down  | 02a7102700100010000000000000 | pen in=1 tip=1 b1=1 b2=0 inv=1 era=1 x=10000 y=4096 p=4096 tx=0 ty=0
pen-tilt               | 02a010270010000014ec00000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=20 ty=-20
eraser-hover           | 02a8102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
eraser-down            | 02a9102700100008000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=1 era=1 x=10000 y=4096 p=2048 tx=0 ty=0
pen-gone               | 02c0670ad7950000000001000000 | pen in=0 tip=0 b1=0 b2=0 inv=0 era=0 x=68199 y=38359 p=0 tx=0 ty=0

# The upper button as a plain second button.
@upper-button button
upper-as-button        | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=1 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
both-as-buttons-down   | 02a7102700100010000000000000 | pen in=1 tip=1 b1=1 b2=1 inv=0 era=0 x=10000 y=4096 p=4096 tx=0 ty=0
eraser-end-as-button   | 02a9102700100008000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=1 era=1 x=10000 y=4096 p=2048 tx=0 ty=0

# Anything but "button" keeps the eraser, so a typo cannot change the pen.
@upper-button eraser
upper-eraser-named     | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@upper-button Button
upper-wrong-case       | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@upper-button unset

# The lower button as an eraser while held: the pen is its eraser, and the button is no button.
@lower-button eraser
lower-as-eraser        | 02a2102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
lower-as-eraser-down   | 02a3102700100010000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=1 era=1 x=10000 y=4096 p=4096 tx=0 ty=0
lower-eraser-let-go    | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
# Anything but "eraser" or "toggle" keeps it a button, so a typo cannot change the pen.
@lower-button Eraser
lower-wrong-case       | 02a2102700100000000000000000 | pen in=1 tip=0 b1=1 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@lower-button unset

# The upper button as a switch: each press goes from pen to eraser or back, and holding it changes nothing more.
@upper-button toggle
toggle-before          | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-press           | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-still-held      | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-let-go          | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-erasing         | 02a1102700100010000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=1 era=1 x=10000 y=4096 p=4096 tx=0 ty=0
toggle-lower-is-button | 02a2102700100000000000000000 | pen in=1 tip=0 b1=1 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
# It stays switched while the pen is away.
toggle-pen-gone        | 02c0102700100000000000000000 | pen in=0 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-back-in-range   | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-press-again     | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-let-go-again    | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-drawing         | 02a1102700100010000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=4096 tx=0 ty=0
# A program loaded afresh starts as the pen, whatever it was before.
toggle-press-third     | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
# Held while the pen is lifted away and brought back, the button was pressed once, so it switched once.
toggle-gone-held       | 02c0102700100000000000000000 | pen in=0 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
toggle-back-held       | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@fresh
toggle-after-reload    | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@upper-button unset

# The lower button as the switch, with the upper one erasing while held.
@lower-button toggle
lower-toggle-press     | 02a2102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
lower-toggle-let-go    | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
lower-toggle-back      | 02a2102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
lower-toggle-upper     | 02a4102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@lower-button unset

# Tablet keys as the pen/eraser switch: the third and the sixth here. A press switches, holding does not
# switch again, another key does nothing to it, and the key itself is still reported.
@switch-keys 36
switch-key-before      | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
switch-key-press       | 02f0040000000000000000000000 | pad keys=3 wheel=0 pan=0
switch-key-erasing     | 02a1102700100010000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=1 era=1 x=10000 y=4096 p=4096 tx=0 ty=0
switch-key-held        | 02f0040000000000000000000000 | pad keys=3 wheel=0 pan=0
switch-key-still       | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
switch-key-and-another | 02f0050000000000000000000000 | pad keys=1,3 wheel=0 pan=0
switch-key-unmoved     | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
switch-key-let-go      | 02f0000000000000000000000000 | pad keys= wheel=0 pan=0
switch-key-kept        | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=1 era=0 x=10000 y=4096 p=0 tx=0 ty=0
switch-key-the-sixth   | 02f0200000000000000000000000 | pad keys=6 wheel=0 pan=0
switch-key-back        | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
@switch-keys unset
# A key that is not named switches nothing.
no-switch-key-press    | 02f0040000000000000000000000 | pad keys=3 wheel=0 pan=0
no-switch-key-pen      | 02a0102700100000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0

# Smoothing over three positions: each one handed on is the average of the latest three, fewer while there
# are fewer. Nothing is averaged across the pen leaving, and the report of its leaving is left as it is.
@smoothing 3
smooth-first           | 02a0b80bb80b0000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=3000 y=3000 p=0 tx=0 ty=0
smooth-second          | 02a07017b80b0000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=4500 y=3000 p=0 tx=0 ty=0
smooth-third           | 02a0282370170000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=6000 y=4000 p=0 tx=0 ty=0
smooth-fourth          | 02a1282370170010000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=8000 y=5000 p=4096 tx=0 ty=0
smooth-at-rest         | 02a1282370170010000000000000 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=9000 y=6000 p=4096 tx=0 ty=0
smooth-gone            | 02c0282370170000000000000000 | pen in=0 tip=0 b1=0 b2=0 inv=0 era=0 x=9000 y=6000 p=0 tx=0 ty=0
smooth-return          | 02a030752c010000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=30000 y=300 p=0 tx=0 ty=0
# The far corner stays the far corner: the third byte of each position is averaged with the rest.
smooth-far-corner-1    | 02a0670ad7950000000001000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=49099 y=19329 p=0 tx=0 ty=0
smooth-far-corner-2    | 02a0670ad7950000000001000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=55466 y=25672 p=0 tx=0 ty=0
smooth-far-corner-3    | 02a0670ad7950000000001000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=68199 y=38359 p=0 tx=0 ty=0
# Anything but 2 to 8 smooths nothing, so a typo cannot make the pen trail.
@smoothing 12
smooth-two-digits-1    | 02a0b80bb80b0000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=3000 y=3000 p=0 tx=0 ty=0
smooth-two-digits-2    | 02a07017b80b0000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=6000 y=3000 p=0 tx=0 ty=0
@smoothing 1
smooth-one-1           | 02a0b80bb80b0000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=3000 y=3000 p=0 tx=0 ty=0
smooth-one-2           | 02a07017b80b0000000000000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=6000 y=3000 p=0 tx=0 ty=0
@smoothing unset

# Tilt switched off: the pen reports none, however it leans.
@tilt off
tilt-off               | 02a010270010000014ec00000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=0 ty=0
tilt-off-full-lean     | 02a1670ad795ff1fc43c01000001 | pen in=1 tip=1 b1=0 b2=0 inv=0 era=0 x=68199 y=38359 p=16383 tx=0 ty=0

# Anything but "off" leaves tilt on, so a typo cannot change the pen.
@tilt on
tilt-on-named          | 02a010270010000014ec00000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=20 ty=-20
@tilt Off
tilt-wrong-case        | 02a010270010000014ec00000000 | pen in=1 tip=0 b1=0 b2=0 inv=0 era=0 x=10000 y=4096 p=0 tx=20 ty=-20
@tilt unset

